<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date{"yyyy-MM-dd'T'HH:mm:ss,SSSXXX", GMT+07:00} %-5level %logger{35} %M line %L - %msg %n
            </pattern>
        </encoder>
    </appender>
    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="com.otwr.notification" level="info" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
</configuration>
